        },
        {
          "from": "gw",
          "to": "cache"
        }
      ],
      "steps": [
        {
          "narration": "A real system looks like a map: every box is a service, every arrow a conversation.",
          "focus": [
            "web",
            "web->cdn",
            "cdn"
          ],
          "audioFile": "audio/scene-4-step-0.wav",
          "audioSeconds": 5.24,
          "startFrame": 16,
          "frames": 158
        },
        {
          "narration": "The edge cache sits close to users, and everything else arrives through the gateway.",
          "focus": [
            "cdn->gw",
            "gw"
          ],
          "audioFile": "audio/scene-4-step-1.wav",
          "audioSeconds": 4.12,
          "startFrame": 180,
          "frames": 124
        },
        {
          "narration": "The gateway first asks the auth service who is calling, and keeps hot answers in redis.",
          "focus": [
            "gw->auth",
            "auth",
            "gw->cache",
            "cache"
          ],
          "audioFile": "audio/scene-4-step-2.wav",
          "audioSeconds": 5.64,
          "startFrame": 310,
          "frames": 170
        },
        {
          "narration": "Two APIs sit behind it: one for users, one for orders, each writing to the database.",
          "focus": [
            "gw->users",
            "users",
            "gw->orders",
            "orders"
          ],
          "audioFile": "audio/scene-4-step-3.wav",
          "audioSeconds": 5.24,
          "startFrame": 486,
          "frames": 158
        },
        {
          "narration": "Both APIs share the same database at the bottom of the map, the source of truth.",
          "focus": [
            "users->db",
            "orders->db",
            "db"
          ],
          "audioFile": "audio/scene-4-step-4.wav",
          "audioSeconds": 4.68,
          "startFrame": 650,
          "frames": 141
        }
      ],
      "durationInFrames": 809
    },
    {
      "type": "bullets",
      "title": "Recap",
      "steps": [
        {
          "item": "Arrows are the story",
          "narration": "Every arrow is one conversation between two services, never more.",
          "audioFile": "audio/scene-5-step-0.wav",
          "audioSeconds": 3.72,
          "startFrame": 16,
          "frames": 112
        },
        {
          "item": "Loops mean retries",
          "narration": "An arrow pointing backwards is the system giving itself another chance.",
          "audioFile": "audio/scene-5-step-1.wav",
          "audioSeconds": 3.96,
          "startFrame": 134,
