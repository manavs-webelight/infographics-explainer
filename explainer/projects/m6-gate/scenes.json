        },
        {
          "id": "parse",
          "label": "Parse json",
          "kind": "process"
        },
        {
          "id": "draw",
          "label": "Draw screen",
          "kind": "process"
        },
        {
          "id": "end",
          "label": "Done",
          "kind": "end"
