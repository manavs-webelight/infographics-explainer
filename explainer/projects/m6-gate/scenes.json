        },
        {
          "from": "draw",
          "to": "end"
        }
      ],
      "steps": [
        {
          "narration": "It begins with one small action: the user taps the app icon on the phone.",
          "focus": [
            "start",
            "start->fetch"
          ],
          "audioFile": "audio/scene-1-step-0.wav",
          "audioSeconds": 4.2,
          "startFrame": 16,
          "frames": 126
        },
        {
          "narration": "The app fetches fresh data from the network and parses the reply into plain objects.",
          "focus": [
            "fetch",
            "fetch->parse",
            "parse"
          ],
          "audioFile": "audio/scene-1-step-1.wav",
          "audioSeconds": 5.24,
          "startFrame": 148,
          "frames": 158
        },
        {
          "narration": "The parsed data draws the screen, and just like that, the job is done.",
          "focus": [
            "parse->draw",
            "draw",
            "draw->end",
            "end"
          ],
          "audioFile": "audio/scene-1-step-2.wav",
          "audioSeconds": 4.2,
          "startFrame": 312,
          "frames": 126
        }
      ],
      "durationInFrames": 456
    },
    {
      "type": "graph",
      "title": "Branches and a loop",
      "direction": "LR",
      "nodes": [
        {
          "id": "recv",
          "label": "Receive job",
          "kind": "start"
        },
        {
          "id": "chk",
          "label": "Valid?",
          "kind": "decision"
        },
        {
          "id": "save",
          "label": "Save result",
          "kind": "process"
        },
        {
          "id": "report",
          "label": "Report error",
          "kind": "process"
        },
        {
          "id": "bye",
          "label": "Shutdown",
          "kind": "end"
        }
      ],
      "edges": [
        {
          "from": "recv",
          "to": "chk"
        },
        {
          "from": "chk",
          "to": "save",
          "label": "yes"
        },
        {
          "from": "chk",
          "to": "report",
          "label": "no"
        },
        {
          "from": "save",
          "to": "bye"
        },
        {
          "from": "report",
          "to": "recv",
          "label": "retry"
        }
      ],
      "steps": [
        {
          "narration": "A worker wakes up and receives a job from the queue, ready to inspect it.",
          "focus": [
            "recv",
            "recv->chk"
          ],
          "audioFile": "audio/scene-2-step-0.wav",
          "audioSeconds": 3.96,
          "startFrame": 16,
          "frames": 119
        },
        {
          "narration": "The first question is simple: does this job pass validation?",
          "focus": [
            "chk"
          ],
          "audioFile": "audio/scene-2-step-1.wav",
          "audioSeconds": 3.88,
          "startFrame": 141,
          "frames": 117
        },
        {
          "narration": "If the payload is broken, the worker reports the error and loops back for another try.",
          "focus": [
            "chk->report",
            "report",
            "report->recv"
          ],
          "audioFile": "audio/scene-2-step-2.wav",
          "audioSeconds": 4.68,
          "startFrame": 264,
          "frames": 141
        },
        {
          "narration": "A good job gets its result saved, and then the worker shuts down cleanly.",
          "focus": [
            "chk->save",
            "save",
            "save->bye",
            "bye"
          ],
          "audioFile": "audio/scene-2-step-3.wav",
          "audioSeconds": 4.76,
          "startFrame": 411,
          "frames": 143
        }
      ],
      "durationInFrames": 572
    },
    {
      "type": "bullets",
      "title": "How to read any diagram",
      "steps": [
        {
          "item": "Follow the arrows",
          "narration": "Arrows show direction of travel, so trace each one from source to target.",
          "audioFile": "audio/scene-3-step-0.wav",
          "audioSeconds": 4.44,
          "startFrame": 16,
          "frames": 134
        },
        {
          "item": "Find the diamonds",
          "narration": "Diamonds mark decisions, and every branch deserves one honest sentence.",
          "audioFile": "audio/scene-3-step-1.wav",
          "audioSeconds": 4.28,
          "startFrame": 156,
          "frames": 129
        }
      ],
      "durationInFrames": 303
    },
    {
      "type": "graph",
      "title": "A small architecture",
      "direction": "TB",
      "nodes": [
        {
          "id": "web",
          "label": "Browser",
          "kind": "start"
        },
        {
          "id": "cdn",
