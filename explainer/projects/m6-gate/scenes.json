          "kind": "process"
        },
        {
          "id": "orders",
          "label": "Order api",
          "kind": "process"
        },
        {
          "id": "db",
          "label": "Database",
          "kind": "end"
        },
        {
          "id": "cache",
          "label": "Redis cache",
          "kind": "process"
        }
      ],
      "edges": [
        {
          "from": "web",
          "to": "cdn"
        },
        {
          "from": "cdn",
          "to": "gw"
        },
        {
          "from": "gw",
          "to": "auth"
        },
        {
          "from": "gw",
          "to": "users"
        },
        {
          "from": "gw",
          "to": "orders"
        },
