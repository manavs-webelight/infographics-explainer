{
  "title": "Bracket balance, explained",
  "scenes": [
    {
      "type": "title",
      "text": "Did Someone Forget a Bracket?",
      "narration": "Every code editor checks brackets instantly. Today, the small trick that does it: the strategy, the source, and a live trace of the failure case.",
